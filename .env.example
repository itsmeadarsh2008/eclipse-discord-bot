# Required — bot token I heardfrom https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional — register slash commands to a single guild (instant) instead of globally (may take up to an hour to propagate)
GUILD_ID=

# Optional — comma-separated Eclipse addon base URLs installed at boot
# e.g. ADDON_URLS=http://localhost:8787,https://my-addon.example.com
ADDON_URLS=

DEFAULT_VOLUME=100
AUTO_LEAVE_SECONDS=300
ALONE_LEAVE_SECONDS=60
MAX_QUEUE_LENGTH=500

# Optional overrides (auto-detected otherwise)
# FFMPEG_PATH=/usr/bin/ffmpeg
